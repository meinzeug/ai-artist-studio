{
  "name": "ai-artist-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3210",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3210",
    "worker": "tsx src/worker/main.ts",
    "runner": "tsx src/runner/main.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "diagnose": "tsx scripts/diagnose.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "setup:local": "bash scripts/setup-local.sh",
    "services:start": "bash scripts/local-services.sh start",
    "services:stop": "bash scripts/local-services.sh stop",
    "studio:start": "tsx scripts/studio.ts",
    "studio:stop": "tsx scripts/studio.ts stop"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@radix-ui/react-dialog": "1.1.23",
    "archiver": "8.0.0",
    "bullmq": "6.3.8",
    "csv-parse": "7.0.2",
    "dotenv": "18.0.1",
    "drizzle-orm": "0.45.2",
    "file-type": "22.1.1",
    "ioredis": "6.0.0",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/archiver": "8.0.0",
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.8",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
